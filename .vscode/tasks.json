{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project: Start",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Project: Stop",
      "type": "shell",
